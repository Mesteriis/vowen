# Development database only. Generate a strong password for a deployed instance.
POSTGRES_PASSWORD=vowen
DATABASE_URL=postgresql+psycopg://vowen:vowen@127.0.0.1:55432/vowen
TEST_DATABASE_URL=postgresql+psycopg://vowen:vowen@127.0.0.1:55432/vowen_test
PUBLIC_HOST=localhost
PUBLIC_BASE_URL=https://localhost:8443
APP_DISPLAY_NAME=Vowen
DEFAULT_TIMEZONE=UTC
TELEGRAM_BOT_USERNAME=vowen_example_bot
TELEGRAM_BOT_TOKEN_FILE=secrets/bot-token
# Legacy reads / migration 0035 only; fresh plaintext databases need no keyring.
DATA_KEYRING_FILE=secrets/keyring.json
LOG_LEVEL=WARNING
# Container UID/GID must own mounted secret files. Set these to your deployment user.
APP_UID=1000
APP_GID=1000
PROXY_IP=10.253.240.2
PROXY_SUBNET=10.253.240.0/29
API_PROXY_IP=10.253.240.3
# Optional LOCAL ONLY login without Telegram. See docs/operations/local-development.md.
# Enabling requires APP_ENV=development, a loopback public URL and a dedicated _dev/_test DB.
APP_ENV=production
DEBUG_AUTH=false
