  "narrative": {
    "northStar": "Dark velvet and warm gold",
    "overview": "The supplied Luxury Rituals Showcase defines the material world: near-black velvet, restrained gold, burgundy accents and warm ivory text. The Gold V Heart-Knot Crest identifies the workspace; the Embossed Velvet V Emblem belongs to startup. Both assets remain local.\n\nDaily screens use readable content, quiet divisions and serif headings. Web and native Android share this palette and identity; Android retains Compose Material components and platform interaction patterns rather than copying browser geometry.",
    "keyCharacteristics": [
      "Dark tonal surfaces with warm, readable text.",
      "Gold actions and burgundy navigation emphasis.",
      "Serif headings paired with system UI body text.",
      "Local crest and velvet startup artwork; responsive native interactions."
    ],
    "rules": [
      {
        "name": "The Material Continuity Rule",
        "body": "Keep the supplied crest, velvet artwork and warm dark palette together across clients.",
        "section": "colors"
      },
      {
        "name": "The Readable Ritual Rule",
        "body": "Use serif type for headings and system UI type for reports, forms and controls; preserve readable wrapping for long content.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Separate daily surfaces with tone and fine warm borders; do not add decorative drop shadows to the extracted web system.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the user-supplied crest and startup artwork as local assets.",
      "Do keep gold focus outlines visible and respect reduced-motion scrolling.",
      "Do retain native Android controls, typography roles and adaptive navigation.",
      "Do present explicit status text alongside status color."
    ],
    "donts": [
      "Don't reproduce miniature low-contrast showcase text in functional controls.",
      "Don't invent portraits, ratings, points or activity metrics to fill the design.",
      "Don't add a fake loading percentage or a cosmetic minimum startup delay."
    ]
  }
}
