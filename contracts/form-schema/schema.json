{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "equals",
            "not_equals",
            "contains",
            "answered"
          ],
          "title": "Op",
          "type": "string"
        },
        "question_id": {
          "maxLength": 64,
          "title": "Question Id",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "question_id",
        "op"
      ],
      "title": "Condition",
      "type": "object"
    },
    "JsonValue": {},
    "Option": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "short_text",
            "long_text",
            "number",
            "date",
            "boolean",
            "single_choice",
            "multiple_choice",
            "scale",
            "rating",
            "acknowledgement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "max_length": {
          "default": 10000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "maxItems": 100,
          "title": "Options",
          "type": "array"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "visibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Visibility"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "title": "Question",
      "type": "object"
    },
    "Visibility": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 100,
          "title": "All",
          "type": "array"
        },
        "any": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 100,
          "title": "Any",
          "type": "array"
        }
      },
      "title": "Visibility",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "default": "",
      "maxLength": 10000,
      "title": "Description",
      "type": "string"
    },
    "kind": {
      "default": "questionnaire",
      "enum": [
        "questionnaire",
        "survey"
      ],
      "title": "Kind",
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "questions"
  ],
  "title": "FormSchema",
  "type": "object"
}
