FROM node:24.20.0-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS builder
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate
WORKDIR /app/web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
COPY static/web/ /app/static/web/
RUN pnpm build
FROM scratch AS assets
COPY --from=builder /app/web/dist /
FROM caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
COPY --from=builder /app/web/dist /srv
COPY deploy/proxy/Caddyfile /etc/caddy/Caddyfile
