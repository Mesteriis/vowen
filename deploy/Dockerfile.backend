FROM python:3.13.15-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b
COPY --from=ghcr.io/astral-sh/uv:0.12.11@sha256:79c6f4776b851471cc73b7d21d0cc834bb94383c292e83640d27eff512864df7 /uv /usr/local/bin/uv
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
COPY backend/src ./src
COPY scripts/normalize_install.py /tmp/normalize_install.py
ARG SOURCE_DATE_EPOCH=0
RUN find . -exec touch -h -d "@$SOURCE_DATE_EPOCH" {} + \
    && uv sync --frozen --no-dev --no-cache --no-editable \
    && python /tmp/normalize_install.py .venv/lib/python3.13/site-packages \
    && rm /tmp/normalize_install.py
COPY backend/alembic.ini ./
COPY backend/migrations ./migrations
COPY static/web/ /app/static/web/
ENV VOWEN_STATIC_ROOT="/app/static/web"
ENV PATH="/app/backend/.venv/bin:$PATH"
USER 1000:1000
CMD ["uvicorn", "vowen.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
